# Configuration du Trading Bot
# Copie ce fichier en .env et remplis tes paramètres

# Mode: PAPER (simulation, recommandé, aucun risque) ou LIVE (argent réel)
# Le mode LIVE nécessite des clés API réelles ci-dessous, sinon le backend
# retombe automatiquement en PAPER par sécurité.
TRADING_MODE=PAPER

# Binance API Keys (uniquement nécessaires en mode LIVE)
# Génère-les dans Binance: Settings -> API Management
BINANCE_API_KEY=ta_cle_api_ici
BINANCE_API_SECRET=ta_cle_secrete_ici

# Paramètres de Trading (les défauts correspondent à la stratégie fournie)
SYMBOL=BTC/USDT
TIMEFRAME=15m
POSITION_SIZE=0.9
TAKE_PROFIT_PCT=2.5
STOP_LOSS_PCT=1.5
RSI_THRESHOLD=30

# Capital virtuel de départ en mode PAPER (USDT)
PAPER_STARTING_BALANCE=1000
